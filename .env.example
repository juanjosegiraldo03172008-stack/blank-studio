# Copia este archivo a .env.local para desarrollo local (.env.local está en
# .gitignore — nunca se sube al repo). En Vercel, configura estas mismas
# variables en Project Settings → Environment Variables.

# Cadena de conexión a PostgreSQL (pedidos, items, inventario — FASE 4A).
# products.ts sigue siendo la fuente de verdad del catálogo; esta base de
# datos NO lo reemplaza.
#
# Formato: postgresql://usuario:password@host:puerto/nombre_basededatos
#
# - Desarrollo: cualquier Postgres local o de prueba.
# - Producción/Preview (Vercel): Neon Postgres (FASE 4C). Usa la cadena
#   "pooled" que te da Neon (host con sufijo -pooler) para evitar agotar
#   conexiones en funciones serverless, con "?sslmode=require" al final —
#   el driver pg estándar la soporta sin configuración adicional.
#
# NUNCA subas el valor real de esta variable al repositorio.
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-pooler.region.aws.neon.tech/valenciano_dev?sslmode=require

# Datos de la cuenta a la que el cliente transfiere directamente el valor de
# las prendas (FASE 4B — pago manual por Nequi/Bancolombia, sin pasarela).
# Se leen SOLO server-side (src/app/pedido/[id]/page.tsx) y se muestran en
# la página de pago del pedido — nunca quedan hardcodeados en el código.
#
# Los valores de abajo son EJEMPLOS FICTICIOS — reemplázalos por los reales
# únicamente en tu .env.local (nunca en este archivo ni en el repo).
PAYMENT_ACCOUNT_HOLDER="Nombre Ejemplo Ficticio"
PAYMENT_NEQUI_NUMBER=3000000000
PAYMENT_BANCOLOMBIA_ACCOUNT=00000000000
PAYMENT_BANCOLOMBIA_ACCOUNT_TYPE="Ahorros"
